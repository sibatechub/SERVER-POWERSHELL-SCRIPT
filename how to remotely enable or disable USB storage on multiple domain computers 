# ===== Function to add log entry =====
function Add-LogEntry {
    param([string]$Computer, [string]$Status, [string]$Message = "")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "[$Timestamp] $Computer - $Status"
    if ($Message -ne "") {
        $LogEntry += " - $Message"
    }
    $LogTextBox.AppendText("$LogEntry`r`n")
    $LogTextBox.ScrollToCaret()
    [System.Windows.Forms.Application]::DoEvents()
}

# ===== Function to Disable USB =====
function Disable-USBOnly {
    param([string]$Computer)
    
    $ScriptBlock = {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\USBSTOR" -Name "Start" -Value 4 -Force
        Stop-Service -Name "USBSTOR" -Force -ErrorAction SilentlyContinue
        
        $RegPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DeviceInstall\Restrictions"
        if (-not (Test-Path $RegPath)) {
            New-Item -Path $RegPath -Force | Out-Null
        }
        Set-ItemProperty -Path $RegPath -Name "DenyRemovableDevices" -Value 1 -Force
        Set-ItemProperty -Path $RegPath -Name "DenyUnspecifiedDevices" -Value 1 -Force
        
        $RegPath2 = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\RemovableStorageDevices"
        if (-not (Test-Path $RegPath2)) {
            New-Item -Path $RegPath2 -Force | Out-Null
        }
        Set-ItemProperty -Path $RegPath2 -Name "Deny_All" -Value 1 -Force
        
        $RegPath3 = "HKLM:\SYSTEM\CurrentControlSet\Control\StorageDevicePolicies"
        if (-not (Test-Path $RegPath3)) {
            New-Item -Path $RegPath3 -Force | Out-Null
        }
        Set-ItemProperty -Path $RegPath3 -Name "WriteProtect" -Value 1 -Force
        
        gpupdate /force
        Restart-Service -Name "PlugPlay" -Force -ErrorAction SilentlyContinue
        
        return "USB Disabled"
    }
    
    $Result = Invoke-Command -ComputerName $Computer -ScriptBlock $ScriptBlock -ErrorAction SilentlyContinue
    return $Result
}

# ===== Function to Enable USB =====
function Enable-USBOnly {
    param([string]$Computer)
    
    $ScriptBlock = {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\USBSTOR" -Name "Start" -Value 3 -Force
        Start-Service -Name "USBSTOR" -ErrorAction SilentlyContinue
        
        $RegPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DeviceInstall\Restrictions"
        if (Test-Path $RegPath) {
            Set-ItemProperty -Path $RegPath -Name "DenyRemovableDevices" -Value 0 -Force
            Set-ItemProperty -Path $RegPath -Name "DenyUnspecifiedDevices" -Value 0 -Force
        }
        
        $RegPath2 = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\RemovableStorageDevices"
        if (Test-Path $RegPath2) {
            Set-ItemProperty -Path $RegPath2 -Name "Deny_All" -Value 0 -Force
        }
        
        $RegPath3 = "HKLM:\SYSTEM\CurrentControlSet\Control\StorageDevicePolicies"
        if (Test-Path $RegPath3) {
            Set-ItemProperty -Path $RegPath3 -Name "WriteProtect" -Value 0 -Force
        }
        
        gpupdate /force
        Restart-Service -Name "PlugPlay" -Force -ErrorAction SilentlyContinue
        
        return "USB Enabled"
    }
    
    $Result = Invoke-Command -ComputerName $Computer -ScriptBlock $ScriptBlock -ErrorAction SilentlyContinue
    return $Result
}

# ===== Disable Button =====
$DisableBtn = New-Object System.Windows.Forms.Button
$DisableBtn.Text = "Disable USB"
$DisableBtn.Location = New-Object System.Drawing.Point(20,540)
$DisableBtn.Size = New-Object System.Drawing.Size(270,45)
$DisableBtn.BackColor = [System.Drawing.Color]::LightCoral
$DisableBtn.Add_Click({
    if ($SelectedList.Items.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("List is empty")
        return
    }
    $LogTextBox.Clear()
    Add-LogEntry -Computer "START" -Status "INFO" -Message "========== Disable USB Operation Started =========="
    Add-LogEntry -Computer "TOTAL" -Status "INFO" -Message "Total computers: $($SelectedList.Items.Count)"
    
    $DisableBtn.Enabled = $false
    $EnableBtn.Enabled = $false
    $ProgressBar.Maximum = $SelectedList.Items.Count
    $ProgressBar.Value = 0
    $Total = $SelectedList.Items.Count
    $Current = 0
    $SuccessCount = 0
    $FailedCount = 0
    $OfflineCount = 0
    
    foreach ($Computer in $SelectedList.Items) {
        $Current++
        $ProgressBar.Value = $Current
        $StatusLabel.Text = "Processing $Computer ($Current / $Total)"
        $StatusLabel.Refresh()
        
        if (Test-Connection $Computer -Count 1 -Quiet) {
            try {
                Disable-USBOnly -Computer $Computer
                Add-LogEntry -Computer $Computer -Status "SUCCESS" -Message "USB Disabled"
                $SuccessCount++
            } catch {
                Add-LogEntry -Computer $Computer -Status "FAILED" -Message "Error: $_"
                $FailedCount++
            }
        } else {
            Add-LogEntry -Computer $Computer -Status "OFFLINE" -Message "Computer not reachable"
            $OfflineCount++
        }
        [System.Windows.Forms.Application]::DoEvents()
    }
    
    Add-LogEntry -Computer "SUMMARY" -Status "INFO" -Message "Success: $SuccessCount, Failed: $FailedCount, Offline: $OfflineCount"
    Add-LogEntry -Computer "END" -Status "INFO" -Message "========== Disable USB Operation Completed =========="
    
    $StatusLabel.Text = "Completed! Success: $SuccessCount, Failed: $FailedCount, Offline: $OfflineCount"
    $ProgressBar.Value = $ProgressBar.Maximum
    $DisableBtn.Enabled = $true
    $EnableBtn.Enabled = $true
})
$Form.Controls.Add($DisableBtn)

