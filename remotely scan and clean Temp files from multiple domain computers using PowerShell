$btnBrowseOU.Add_Click({
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        $allOUs = Get-ADOrganizationalUnit -Filter * | Select-Object -ExpandProperty DistinguishedName
        
        $ouForm = New-Object System.Windows.Forms.Form
        $ouForm.Text = "Select Active Directory OU"
        $ouForm.Size = New-Object System.Drawing.Size(500, 400)
        $ouForm.StartPosition = "CenterParent"
        
        $ouList = New-Object System.Windows.Forms.ListBox
        $ouList.Location = New-Object System.Drawing.Point(15, 15)
        $ouList.Size = New-Object System.Drawing.Size(455, 300)
        $ouList.HorizontalScrollbar = $true
        foreach($ou in $allOUs) { [void]$ouList.Items.Add($ou) }
        $ouForm.Controls.Add($ouList)
        
        $btnSelect = New-Object System.Windows.Forms.Button
        $btnSelect.Text = "Select & Load"
        $btnSelect.Location = New-Object System.Drawing.Point(370, 325)
        $btnSelect.Size = New-Object System.Drawing.Size(100, 25)
        $btnSelect.DialogResult = [System.Windows.Forms.DialogResult]::OK
        $ouForm.Controls.Add($btnSelect)
        
        if ($ouForm.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK -and $ouList.SelectedItem) {
            $txtOU.Text = $ouList.SelectedItem
            $bs.PerformClick()
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Error loading OUs: $_")
    }
})

$bs.Add_Click({
    $lb.Items.Clear()
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        $q = $tb.Text.Trim()
        $targetOU = $txtOU.Text.Trim()
        
        if ([string]::IsNullOrEmpty($targetOU)) {
            if ([string]::IsNullOrEmpty($q)) {
                $res = Get-ADComputer -Filter * | Select-Object -ExpandProperty Name
            } else {
                $res = Get-ADComputer -Filter "Name -like '*$q*'" | Select-Object -ExpandProperty Name
            }
        } else {
            if ([string]::IsNullOrEmpty($q)) {
                $res = Get-ADComputer -Filter * -SearchBase $targetOU | Select-Object -ExpandProperty Name
            } else {
                $res = Get-ADComputer -Filter "Name -like '*$q*'" -SearchBase $targetOU | Select-Object -ExpandProperty Name
            }
        }
        
        foreach($x in $res) { [void]$lb.Items.Add($x) }
        $lbl.Text = "Loaded $($res.Count) computers from AD."
    } catch {
        [System.Windows.Forms.MessageBox]::Show("AD Error: $_")
    }
})

$btnSelectAll.Add_Click({
    for ($i = 0; $i -lt $lb.Items.Count; $i++) {
        $lb.SetSelected($i, $true)
    }
})

$btnRemove.Add_Click({
    $indices = $lb.SelectedIndices | Sort-Object -Descending
    foreach ($index in $indices) {
        $lb.Items.RemoveAt($index)
    }
})

function Invoke-ParallelExecution {
    param($computers, $isScanMode, $wTemp, $uTemp, $rBin, $updCache, $maxJobs)
    
    $scriptBlock = {
        param($computer, $scanMode, $wt, $ut, $rb, $uc)
        
        $wtBytes = 0; $utBytes = 0; $rbBytes = 0; $ucBytes = 0
        $deletedCount = 0; $failedCount = 0; $errMsg = "OK"
        
        try {
            $remoteBlock = {
                param($sMode, $wTemp, $uTemp, $rBin, $updCache)
                
                $localWt = 0; $localUt = 0; $localRb = 0; $localUc = 0
                $script:delCount = 0
                $script:failCount = 0
                $doDelete = (-not $sMode)

                function Process-FolderSafely {
                    param($pathStr, $deleteFlag)
                    $localSize = 0
                    if (Test-Path $pathStr) {
                        $items = Get-ChildItem -Path $pathStr -Force -ErrorAction SilentlyContinue
                        foreach ($item in $items) {
                            if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) { continue }
                            if ($item.PSIsContainer) {
                                $localSize += (Process-FolderSafely $item.FullName $deleteFlag)
                            } else {
                                try {
                                    $sz = $item.Length
                                    if ($deleteFlag) {
                                        Remove-Item $item.FullName -Force -ErrorAction Stop
                                        $script:delCount++
                                        $localSize += $sz
                                    } else {
                                        $localSize += $sz
                                        $script:delCount++
                                    }
                                } catch {
                                    $script:failCount++
                                }
                            }
                        }
                    }
                    return $localSize
                }

                if ($wTemp) {
                    $localWt = Process-FolderSafely "C:\Windows\Temp" $doDelete
                }

                if ($uTemp) {
                    $profiles = Get-CimInstance Win32_UserProfile | Where-Object { $_.Special -eq $false -and (Test-Path $_.LocalPath) }
                    foreach ($prof in $profiles) {
                        $uPath = Join-Path $prof.LocalPath "AppData\Local\Temp"
                        $localUt += Process-FolderSafely $uPath $doDelete
                    }
                }

                if ($rBin) {
                    $drives = Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3"
                    foreach ($drv in $drives) {
                        $rbPath = "$($drv.DeviceID)\`$Recycle.Bin"
                        if (Test-Path $rbPath) {
                            $localRb += Process-FolderSafely $rbPath $doDelete
                        }
                    }
                }

                if ($updCache) {
                    $updPath = "C:\Windows\SoftwareDistribution\Download"
                    $svc = Get-Service -Name wuauserv -ErrorAction SilentlyContinue
                    $wasRunning = $svc -and $svc.Status -eq 'Running'
                    if ($wasRunning -and $doDelete) {
                        Stop-Service -Name wuauserv -Force -ErrorAction SilentlyContinue
                        Start-Sleep -Seconds 1
                    }
                    $localUc = Process-FolderSafely $updPath $doDelete
                    if ($wasRunning -and $doDelete) {
                        Start-Service -Name wuauserv -ErrorAction SilentlyContinue
                    }
                }

                return [PSCustomObject]@{
                    WT = $localWt
                    UT = $localUt
                    RB = $localRb
                    UC = $localUc
                    Deleted = $script:delCount
                    Failed = $script:failCount
                }
            }

            $resRemote = Invoke-Command -ComputerName $computer -ScriptBlock $remoteBlock -ArgumentList $scanMode, $wt, $ut, $rb, $uc -ErrorAction Stop
            $wtBytes = $resRemote.WT
            $utBytes = $resRemote.UT
            $rbBytes = $resRemote.RB
            $ucBytes = $resRemote.UC
            $deletedCount = $resRemote.Deleted
            $failedCount = $resRemote.Failed

        } catch {
            $errMsg = $_.Exception.Message
        }
        
        return [PSCustomObject]@{
            Computer = $computer
            Mode     = $(if ($scanMode) { "Scan" } else { "Clean" })
            WT       = [Math]::Round($wtBytes / 1MB, 2)
            UT       = [Math]::Round($utBytes / 1MB, 2)
            RB       = [Math]::Round($rbBytes / 1MB, 2)
            UC       = [Math]::Round($ucBytes / 1MB, 2)
            Total    = [Math]::Round(($wtBytes + $utBytes + $rbBytes + $ucBytes) / 1MB, 2)
            Deleted  = $deletedCount
            Failed   = $failedCount
            Status   = $(if ($errMsg -eq "OK") { "Success" } else { "Failed" })
            Details  = $errMsg
        }
    }

    $jobs = @()
    $results = @()
    
    foreach ($pc in $computers) {
        while ((Get-Job -State Running).Count -ge $maxJobs) {
            Start-Sleep -Milliseconds 200
        }
        $jobs += Start-Job -ScriptBlock $scriptBlock -ArgumentList $pc, $isScanMode, $wTemp, $uTemp, $rBin, $updCache
    }

    while ((Get-Job -State Running).Count -gt 0) {
        Start-Sleep -Milliseconds 300
    }

    foreach ($job in $jobs) {
        $results += Receive-Job -Job $job
        Remove-Job -Job $job
    }

    return $results
}

$bscan.Add_Click({
    if ($lb.SelectedItems.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Select computers first.")
        return
    }
    $dgv.Rows.Clear()
    $selectedPCs = $lb.SelectedItems
    $maxJobs = [int]$cmbThreads.SelectedItem
    $pg.Maximum = $selectedPCs.Count
    $pg.Value = 0
    $lbl.Text = "Status: Scanning in parallel..."
    [System.Windows.Forms.Application]::DoEvents()

    $res = Invoke-ParallelExecution -computers $selectedPCs -isScanMode $true -wTemp $c1.Checked -uTemp $c2.Checked -rBin $c3.Checked -updCache $c4.Checked -maxJobs $maxJobs

    foreach ($r in $res) {
        $dgv.Rows.Add($r.Computer, $r.Mode, "$($r.WT) MB", "$($r.UT) MB", "$($r.RB) MB", "$($r.UC) MB", "$($r.Total) MB", $r.Deleted, $r.Failed, $r.Status, $r.Details)
    }
    $pg.Value = $pg.Maximum
    $lbl.Text = "Status: Scan Complete!"
})

$bclean.Add_Click({
    if ($lb.SelectedItems.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Select computers first.")
        return
    }
    if ([System.Windows.Forms.MessageBox]::Show("Start cleaning selected computers?", "Confirm", [System.Windows.Forms.MessageBoxButtons]::YesNo) -ne [System.Windows.Forms.DialogResult]::Yes) {
        return
    }
    $dgv.Rows.Clear()
    $selectedPCs = $lb.SelectedItems
    $maxJobs = [int]$cmbThreads.SelectedItem
    $pg.Maximum = $selectedPCs.Count
    $pg.Value = 0
    $lbl.Text = "Status: Cleaning in parallel..."
    [System.Windows.Forms.Application]::DoEvents()

    $res = Invoke-ParallelExecution -computers $selectedPCs -isScanMode $false -wTemp $c1.Checked -uTemp $c2.Checked -rBin $c3.Checked -updCache $c4.Checked -maxJobs $maxJobs

    foreach ($r in $res) {
        $dgv.Rows.Add($r.Computer, $r.Mode, "$($r.WT) MB", "$($r.UT) MB", "$($r.RB) MB", "$($r.UC) MB", "$($r.Total) MB", $r.Deleted, $r.Failed, $r.Status, $r.Details)
    }
    $pg.Value = $pg.Maximum
    $lbl.Text = "Status: Cleanup Complete!"
    [System.Windows.Forms.MessageBox]::Show("Parallel cleanup finished.", "Done")
})

