# ===== Load Computers from OU =====
function LoadComputersFromOU {
    $ComboBox.Items.Clear()
    $ComboBox.Text = "Loading..."
    $SelectedOU = $OUCombo.SelectedItem
    if (-not $SelectedOU) { return }
    try {
        $Computers = Get-ADComputer -Filter * -SearchBase "OU=$SelectedOU,$((Get-ADDomain).DistinguishedName)" | Select-Object -ExpandProperty Name | Sort-Object
        foreach ($Computer in $Computers) {
            $ComboBox.Items.Add($Computer)
        }
        if ($ComboBox.Items.Count -gt 0) {
            $ComboBox.SelectedIndex = 0
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Error loading computers: $_")
    }
    $ComboBox.Text = ""
}

$OUCombo.Add_SelectedIndexChanged({ LoadComputersFromOU })
