$DashboardPath = "C:\Dashboard"
$JsonFile = "$DashboardPath\data.json"
$HtmlFile = "$DashboardPath\dashboard.html"

New-Item -ItemType Directory -Path $DashboardPath -Force | Out-Null

# Get Domain Computers
$Computers = Get-ADComputer -Filter * | Select-Object -ExpandProperty Name

# =========================
# Create HTML Dashboard
# =========================

@"
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Live Monitoring Dashboard</title>

<style>

body{
    background:#0f1117;
    color:white;
    font-family:Arial;
    margin:0;
    padding:0;
}

h1{
    text-align:center;
    padding:20px;
    font-size:35px;
}

table{
    width:85%;
    margin:auto;
    border-collapse:collapse;
    margin-bottom:30px;
}

th{
    background:#1f2937;
    padding:15px;
    font-size:22px;
}

td{
    padding:14px;
    text-align:center;
    font-size:20px;
    border-bottom:1px solid #333;
}

tr:nth-child(even){
    background:#161b22;
}

.online{
    color:#00ff88;
    font-weight:bold;
}

.offline{
    color:#ff4d4d;
    font-weight:bold;
}

.nointernet{
    color:#ffd166;
    font-weight:bold;
}

</style>
</head>

<body>

<h1>⚡ Live Internet Monitoring Dashboard</h1>

<table>

<thead>
<tr>
<th>Computer Name</th>
<th>Status</th>
<th>Last Update</th>
</tr>
</thead>

<tbody id="tableBody">
</tbody>

</table>

<script>

async function loadData(){

    try{

        const response = await fetch('data.json?t=' + new Date().getTime());

        const data = await response.json();

        let rows = '';

        data.forEach(item => {

            let css = '';

            if(item.Status.includes('Online')){
                css = 'online';
            }
            else if(item.Status.includes('Offline')){
                css = 'offline';
            }
            else{
                css = 'nointernet';
            }

            rows += `
            <tr>
                <td>${item.Computer}</td>
                <td class="${css}">${item.Status}</td>
                <td>${item.Time}</td>
            </tr>
            `;
        });

        document.getElementById('tableBody').innerHTML = rows;

    }
    catch(err){
        console.log(err);
    }
}

loadData();

# Real-Time Refresh
setInterval(loadData,1000);

</script>

</body>
</html>
"@ | Out-File $HtmlFile -Encoding UTF8

# =========================
# Open Dashboard
# =========================

Start-Process $HtmlFile

# =========================
# Live Monitoring Loop
# =========================

while ($true) {

    $Results = foreach ($Computer in $Computers) {

        try {

            $Ping = Test-Connection $Computer -Count 1 -Quiet -ErrorAction Stop

            if ($Ping) {

                $Internet = Invoke-Command -ComputerName $Computer -ScriptBlock {
                    Test-Connection 8.8.8.8 -Count 1 -Quiet
                } -ErrorAction Stop

                if ($Internet) {
                    $Status = "🟢 Online"
                }
                else {
                    $Status = "🟡 No Internet"
                }

            }
            else {
                $Status = "🔴 Offline"
            }

        }
        catch {
            $Status = "🔴 Offline"
        }

        [PSCustomObject]@{
            Computer = $Computer
            Status   = $Status
            Time     = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        }
    }

    $Results | ConvertTo-Json | Out-File $JsonFile -Encoding UTF8

    Start-Sleep 5
}