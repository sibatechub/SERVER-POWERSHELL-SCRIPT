$btnPing.Add_Click({
    $selected = $clbComputers.CheckedItems
    if ($selected.Count -eq 0) { 
        [System.Windows.Forms.MessageBox]::Show("Please select at least one computer.", "Warning", 
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
        return 
    }
    
    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
    $total = $selected.Count
    $current = 0
    
    foreach ($pc in $selected) {
        $current++
        Update-Progress -current $current -total $total -status "Pinging $pc"
        
        if (Test-Connection -ComputerName $pc -Count 1 -Quiet -ErrorAction SilentlyContinue) {
            Write-Log "Ping -> $pc : ONLINE"
        } else {
            Write-Log "Ping -> $pc : OFFLINE"
        }
    }
    
    Update-Progress -current $total -total $total -status "Complete"
    $form.Cursor = [System.Windows.Forms.Cursors]::Default
    [System.Windows.Forms.MessageBox]::Show("Ping completed for $total computers.", "Done", 
        [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
})

$btnBlock.Add_Click({
    $selected = $clbComputers.CheckedItems
    $domainInput = $txtDomain.Text.Trim().ToLower()
    $targetIP = $txtIP.Text.Trim()

    if ($selected.Count -eq 0) {
        [System.Windows.Forms.MessageBox]::Show("Please select at least one computer.", "Warning", 
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
        return
    }
    if ([string]::IsNullOrWhiteSpace($domainInput)) {
        [System.Windows.Forms.MessageBox]::Show("Please enter a website domain.", "Warning", 
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
        return
    }

    $parsedIP = $null
    if (-not [System.Net.IPAddress]::TryParse($targetIP, [ref]$parsedIP)) {
        [System.Windows.Forms.MessageBox]::Show("Invalid IP Address format!`nExample: 0.0.0.0 or 127.0.0.1", "Error", 
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
        return
    }

    $domainsToAdd = @($domainInput)
    if (-not $domainInput.StartsWith("www.")) {
        $domainsToAdd += "www.$domainInput"
    }

    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
    $total = $selected.Count
    $current = 0
    $successCount = 0
    $failedCount = 0
    $alreadyBlockedCount = 0

    Write-Log "========== BLOCK OPERATION STARTED =========="
    Write-Log "Domain(s): $($domainsToAdd -join ', ')"
    Write-Log "IP: $targetIP"
    Write-Log "Target computers: $total"
    Write-Log "-------------------------------------------"

    foreach ($pc in $selected) {
        $current++
        Update-Progress -current $current -total $total -status "Processing $pc"
        Write-Log "Processing $pc..."

        $hostsPath = "\\$pc\c$\Windows\System32\drivers\etc\hosts"
        $backupDir = "\\$pc\c$\Windows\System32\drivers\etc\backups"

        try {
            if (-not (Test-RemoteAccess -ComputerName $pc)) {
                Write-Log "  -> $pc : ACCESS DENIED / NOT FOUND"
                $failedCount++
                continue
            }

            if (-not (Test-Path $backupDir)) {
                New-Item -Path $backupDir -ItemType Directory -Force -ErrorAction Stop | Out-Null
            }

            $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
            $backupPath = Join-Path $backupDir "hosts.bak_$timestamp"
            Copy-Item -Path $hostsPath -Destination $backupPath -Force -ErrorAction Stop

            $hostsLines = Get-Content -Path $hostsPath -ErrorAction Stop
            $addedAny = $false
            $existingDomains = @()

            foreach ($dom in $domainsToAdd) {
                $exists = $false
                foreach ($line in $hostsLines) {
                    $clean = $line.Trim()
                    if ($clean.StartsWith("#") -or [string]::IsNullOrWhiteSpace($clean)) { continue }
                    $parts = -split $clean
                    if ($parts.Count -ge 2 -and $parts[1].ToLower() -eq $dom) {
                        $exists = $true
                        $existingDomains += $dom
                        break
                    }
                }

                if (-not $exists) {
                    $newEntry = "`n$targetIP`t$dom"
                    Add-Content -Path $hostsPath -Value $newEntry -Force -ErrorAction Stop
                    $addedAny = $true
                }
            }

            if ($addedAny) {
                Write-Log "  -> $pc : SUCCESS (Blocked)"
                $successCount++
            } else {
                Write-Log "  -> $pc : ALREADY BLOCKED ($($existingDomains -join ', '))"
                $alreadyBlockedCount++
            }
        }
        catch {
            Write-Log "  -> $pc : FAILED ($($_.Exception.Message))"
            $failedCount++
        }
    }

    Write-Log "-------------------------------------------"
    Write-Log "Block operation completed:"
    Write-Log "  - Success: $successCount"
    Write-Log "  - Already blocked: $alreadyBlockedCount"
    Write-Log "  - Failed: $failedCount"
    Write-Log "========== BLOCK OPERATION ENDED =========="

    Update-Progress -current $total -total $total -status "Complete"
    $form.Cursor = [System.Windows.Forms.Cursors]::Default
    
    [System.Windows.Forms.MessageBox]::Show(
        "Blocking process completed.`n`nSuccess: $successCount`nAlready blocked: $alreadyBlockedCount`nFailed: $failedCount", 
        "Operation Complete", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
})

