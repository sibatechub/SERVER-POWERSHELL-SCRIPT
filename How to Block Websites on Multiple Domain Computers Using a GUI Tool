function Write-Log {
    param([string]$message)
    $timestamp = Get-Date -Format "HH:mm:ss"
    $txtLog.AppendText("[$timestamp] $message`r`n")
    $txtLog.SelectionStart = $txtLog.Text.Length
    $txtLog.ScrollToCaret()
    [System.Windows.Forms.Application]::DoEvents()
}

function Update-Progress {
    param([int]$current, [int]$total, [string]$status = "")
    if ($total -gt 0) {
        $percent = [math]::Round(($current / $total) * 100)
        $progressBar.Value = $percent
        if ($status) {
            $progressBar.AccessibleDescription = $status
        }
    }
    [System.Windows.Forms.Application]::DoEvents()
}

function Test-RemoteAccess {
    param($ComputerName)
    try {
        Test-Path "\\$ComputerName\c$\Windows\System32\drivers\etc\hosts" -ErrorAction Stop
        return $true
    } catch {
        return $false
    }
}

function Update-ComputerList {
    param([string]$filter = "")
    
    $clbComputers.Items.Clear()
    
    if ([string]::IsNullOrWhiteSpace($filter) -or $filter -eq "Type to filter computers...") {
        foreach ($comp in $allComputersCache) {
            [void]$clbComputers.Items.Add($comp)
        }
        $global:filteredComputers = $allComputersCache
        return
    }
    
    $results = $allComputersCache | Where-Object { $_.ToLower().StartsWith($filter.ToLower()) } | Sort-Object
    
    if ($results.Count -eq 0) {
        [void]$clbComputers.Items.Add("No computers found")
    } else {
        foreach ($comp in $results) {
            [void]$clbComputers.Items.Add($comp)
        }
    }
    $global:filteredComputers = $results
}

function Load-ActiveDirectoryData {
    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
    try {
        Import-Module ActiveDirectory -ErrorAction Stop

        $cmbOUs.Items.Clear()
        [void]$cmbOUs.Items.Add("[ All Computers / Root Domain ]")
        
        $ous = Get-ADOrganizationalUnit -Filter * | Select-Object -ExpandProperty DistinguishedName
        foreach ($ou in $ous) {
            [void]$cmbOUs.Items.Add($ou)
        }
        $cmbOUs.SelectedIndex = 0

        Load-ComputersBySelection
        Write-Log "Successfully loaded AD OUs and Computers."
    }
    catch {
        Write-Log "ERROR: Failed to load Active Directory structure."
        [System.Windows.Forms.MessageBox]::Show("Error loading Active Directory module or OUs.`nMake sure you have the ActiveDirectory module installed and proper permissions.", 
            "Error", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
    }
    finally {
        $form.Cursor = [System.Windows.Forms.Cursors]::Default
    }
}

function Load-ComputersBySelection {
    $selectedOU = $cmbOUs.SelectedItem
    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor

    try {
        if ($selectedOU -eq "[ All Computers / Root Domain ]" -or -not $selectedOU) {
            $computers = Get-ADComputer -Filter * -Properties Name -ResultPageSize 1000 | 
                         Select-Object -ExpandProperty Name | 
                         Sort-Object
        } else {
            $computers = Get-ADComputer -Filter * -SearchBase $selectedOU -Properties Name -ResultPageSize 1000 | 
                         Select-Object -ExpandProperty Name | 
                         Sort-Object
        }

        $global:allComputersCache = $computers
        Update-ComputerList -filter $txtFilter.Text
        Write-Log "Loaded $($computers.Count) computers from selected OU."
    }
    catch {
        Write-Log "ERROR: Failed to load computers for the selected OU."
        [System.Windows.Forms.MessageBox]::Show("Failed to load computers. Check your connection and permissions.", 
            "Error", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
    }
    finally {
        $form.Cursor = [System.Windows.Forms.Cursors]::Default
    }
}

