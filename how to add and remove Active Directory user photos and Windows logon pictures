function Invoke-AddUserPhoto {
    param(
        [string]$UserName,
        [string]$ComputerName,
        [string]$ImagePath
    )

    if ([string]::IsNullOrWhiteSpace($UserName)) {
        [System.Windows.Forms.MessageBox]::Show("Please select username.", "Error", "OK", "Warning")
        return $false
    }
    if ([string]::IsNullOrWhiteSpace($ComputerName)) {
        [System.Windows.Forms.MessageBox]::Show("Please select computer name.", "Error", "OK", "Warning")
        return $false
    }
    if (-not (Test-Path $ImagePath)) {
        [System.Windows.Forms.MessageBox]::Show("Please select a valid image.", "Error", "OK", "Warning")
        return $false
    }

    $lblStatus.Text = "Processing..."
    $lblStatus.ForeColor = [System.Drawing.Color]::DarkOrange
    $progressBar.Value = 5
    $btnAdd.Enabled = $false
    $btnRemove.Enabled = $false
    $form.Refresh()

    try {
        $lblStatus.Text = "[1/5] Reading image..."
        $form.Refresh()
        $bytes = [System.IO.File]::ReadAllBytes($ImagePath)
        $progressBar.Value = 15

        if ($bytes.Length -gt 102400) {
            $result = [System.Windows.Forms.MessageBox]::Show(
                "Image size exceeds 100KB (current: $([math]::Round($bytes.Length/1024, 2)) KB).`n`nMay not display correctly.`nContinue?",
                "Warning: Large Image",
                "YesNo",
                "Warning"
            )
            if ($result -eq "No") {
                $lblStatus.Text = "Cancelled"
                $lblStatus.ForeColor = [System.Drawing.Color]::Red
                $btnAdd.Enabled = $true
                $btnRemove.Enabled = $true
                return $false
            }
        }
        $progressBar.Value = 25

        $lblStatus.Text = "[2/5] Saving to Active Directory..."
        $form.Refresh()
        Import-Module ActiveDirectory -ErrorAction Stop
        Set-ADUser -Identity $UserName -Replace @{thumbnailPhoto = $bytes} -ErrorAction Stop
        $progressBar.Value = 40

        $adUser = Get-ADUser -Identity $UserName -Properties SID -ErrorAction Stop
        $UserSID = $adUser.SID.Value
        $progressBar.Value = 50

        $lblStatus.Text = "[3/5] Preparing images..."
        $form.Refresh()
        $tempDir = "C:\Temp\UserPhoto_$UserName"
        if (Test-Path $tempDir) { Remove-Item -Path $tempDir -Recurse -Force }
        New-Item -ItemType Directory -Path $tempDir -Force | Out-Null

        $sizes = @(32, 40, 48, 96, 192, 200, 240, 448)
        $imgStream = New-Object System.IO.MemoryStream($bytes, $false)
        $originalImage = [System.Drawing.Image]::FromStream($imgStream)
        $totalSizes = $sizes.Count
        $currentSize = 0

        foreach ($size in $sizes) {
            $currentSize++
            $percent = 50 + [int](($currentSize / $totalSizes) * 30)
            $progressBar.Value = $percent
            $lblStatus.Text = "[3/5] Processing ${size}px image..."
            $form.Refresh()

            $resized = New-Object System.Drawing.Bitmap($size, $size)
            $graphics = [System.Drawing.Graphics]::FromImage($resized)
            $graphics.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
            $graphics.DrawImage($originalImage, 0, 0, $size, $size)
            $graphics.Dispose()
            
            $filePath = Join-Path $tempDir "Image$size.jpg"
            $resized.Save($filePath, [System.Drawing.Imaging.ImageFormat]::Jpeg)
            $resized.Dispose()
        }
        $originalImage.Dispose()
        $imgStream.Dispose()
        $progressBar.Value = 80

        $lblStatus.Text = "[4/5] Pushing to $ComputerName..."
        $form.Refresh()

        $remoteUserDir = "C:\Users\Public\AccountPictures\$UserSID"
        $remoteRegPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AccountPicture\Users\$UserSID"

        $ping = Test-Connection -ComputerName $ComputerName -Count 1 -Quiet
        if (-not $ping) {
            throw "Computer $ComputerName is not reachable!"
        }

        try {
            $session = New-PSSession -ComputerName $ComputerName -ErrorAction Stop
        } catch {
            throw "Cannot connect to $ComputerName via WinRM."
        }

        Invoke-Command -Session $session -ScriptBlock {
            param($RemoteDir, $RegPath)
            if (-not (Test-Path $RemoteDir)) {
                New-Item -ItemType Directory -Path $RemoteDir -Force | Out-Null
                (Get-Item $RemoteDir).Attributes = "Hidden"
            }
            if (-not (Test-Path $RegPath)) {
                New-Item -Path $RegPath -Force | Out-Null
            }
        } -ArgumentList $remoteUserDir, $remoteRegPath

        foreach ($size in $sizes) {
            $localFile = Join-Path $tempDir "Image$size.jpg"
            $remoteFile = "$remoteUserDir\Image$size.jpg"
            Copy-Item -Path $localFile -Destination $remoteFile -ToSession $session -Force
        }

        Invoke-Command -Session $session -ScriptBlock {
            param($SID)
            $regPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AccountPicture\Users\$SID"
            $baseDir = "C:\Users\Public\AccountPictures\$SID"
            $sizes = @(32, 40, 48, 96, 192, 200, 240, 448)
            
            foreach ($size in $sizes) {
                $filePath = "$baseDir\Image$size.jpg"
                if (Test-Path $filePath) {
                    Set-ItemProperty -Path $regPath -Name "Image$size" -Value $filePath -Force
                }
            }
        } -ArgumentList $UserSID

        Invoke-Command -Session $session -ScriptBlock {
            Restart-Service -Name "WbioSrvc" -ErrorAction SilentlyContinue
            Remove-Item -Path "$env:USERPROFILE\AppData\Local\Temp\*User*.jpg" -Force -ErrorAction SilentlyContinue
            Remove-Item -Path "$env:USERPROFILE\AppData\Local\Microsoft\Windows\AccountPictures\*" -Force -ErrorAction SilentlyContinue
        }

        Remove-PSSession $session
        Remove-Item -Path $tempDir -Recurse -Force

        $progressBar.Value = 100
        $lblStatus.Text = "Photo added successfully!"
        $lblStatus.ForeColor = [System.Drawing.Color]::DarkGreen
        $btnAdd.Enabled = $true
        $btnRemove.Enabled = $true

        try {
            $msg = "Your profile photo has been added successfully!`n`nPlease restart your computer for the changes to take effect."
            Invoke-Command -ComputerName $ComputerName -ScriptBlock {
                param($Message)
                Add-Type -AssemblyName System.Windows.Forms
                [System.Windows.Forms.MessageBox]::Show($Message, "Photo Updated", "OK", "Information")
            } -ArgumentList $msg -ErrorAction SilentlyContinue
        } catch {}

        [System.Windows.Forms.MessageBox]::Show(
            "Photo added and client configured successfully!`n`n" +
            "User: $UserName`n" +
            "Computer: $ComputerName`n`n" +
            "Ask user to restart their computer.",
            "Success",
            "OK",
            "Information"
        )
        return $true

    } catch {
        $lblStatus.Text = "Error: $($_.Exception.Message)"
        $lblStatus.ForeColor = [System.Drawing.Color]::Red
        $btnAdd.Enabled = $true
        $btnRemove.Enabled = $true
        $progressBar.Value = 0

        [System.Windows.Forms.MessageBox]::Show(
            "Error:`n`n$($_.Exception.Message)",
            "Error",
            "OK",
            "Error"
        )
        return $false
    }
}

function Invoke-RemoveUserPhoto {
    param(
        [string]$UserName,
        [string]$ComputerName
    )

    if ([string]::IsNullOrWhiteSpace($UserName)) {
        [System.Windows.Forms.MessageBox]::Show("Please select username.", "Error", "OK", "Warning")
        return $false
    }
    if ([string]::IsNullOrWhiteSpace($ComputerName)) {
        [System.Windows.Forms.MessageBox]::Show("Please select computer name.", "Error", "OK", "Warning")
        return $false
    }

    $confirm = [System.Windows.Forms.MessageBox]::Show(
        "Are you sure you want to remove photo for user $UserName?`n`n" +
        "This will remove from Active Directory and computer $ComputerName.",
        "Confirm Removal",
        "YesNo",
        "Warning"
    )
    if ($confirm -eq "No") {
        $lblStatus.Text = "Cancelled"
        $lblStatus.ForeColor = [System.Drawing.Color]::Red
        return $false
    }

    $lblStatus.Text = "Removing photo..."
    $lblStatus.ForeColor = [System.Drawing.Color]::DarkOrange
    $progressBar.Value = 10
    $btnAdd.Enabled = $false
    $btnRemove.Enabled = $false
    $form.Refresh()

    try {
        $lblStatus.Text = "[1/3] Getting user data..."
        $form.Refresh()
        Import-Module ActiveDirectory -ErrorAction Stop
        
        $adUser = Get-ADUser -Identity $UserName -Properties SID -ErrorAction Stop
        $UserSID = $adUser.SID.Value
        $progressBar.Value = 30

        $lblStatus.Text = "[2/3] Removing from Active Directory..."
        $form.Refresh()
        Set-ADUser -Identity $UserName -Clear thumbnailPhoto -ErrorAction Stop
        $progressBar.Value = 60

        $lblStatus.Text = "[3/3] Removing from $ComputerName..."
        $form.Refresh()

        $ping = Test-Connection -ComputerName $ComputerName -Count 1 -Quiet
        if ($ping) {
            try {
                $session = New-PSSession -ComputerName $ComputerName -ErrorAction Stop
                
                Invoke-Command -Session $session -ScriptBlock {
                    param($SID)
                    $userDir = "C:\Users\Public\AccountPictures\$SID"
                    if (Test-Path $userDir) {
                        Remove-Item -Path $userDir -Recurse -Force
                    }
                    
                    $regPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AccountPicture\Users\$SID"
                    if (Test-Path $regPath) {
                        Remove-Item -Path $regPath -Recurse -Force
                    }
                    
                    Remove-Item -Path "$env:USERPROFILE\AppData\Local\Temp\*User*.jpg" -Force -ErrorAction SilentlyContinue
                    Remove-Item -Path "$env:USERPROFILE\AppData\Local\Microsoft\Windows\AccountPictures\*" -Force -ErrorAction SilentlyContinue
                    
                    Restart-Service -Name "WbioSrvc" -ErrorAction SilentlyContinue
                } -ArgumentList $UserSID
                
                Remove-PSSession $session
            } catch {}
        }

        $progressBar.Value = 100
        $lblStatus.Text = "Photo removed successfully!"
        $lblStatus.ForeColor = [System.Drawing.Color]::DarkGreen
        $btnAdd.Enabled = $true
        $btnRemove.Enabled = $true

        [System.Windows.Forms.MessageBox]::Show(
            "Photo removed successfully!`n`n" +
            "User: $UserName`n" +
            "Computer: $ComputerName`n`n" +
            "Ask user to restart their computer.",
            "Success",
            "OK",
            "Information"
        )
        return $true

    } catch {
        $lblStatus.Text = "Error: $($_.Exception.Message)"
        $lblStatus.ForeColor = [System.Drawing.Color]::Red
        $btnAdd.Enabled = $true
        $btnRemove.Enabled = $true
        $progressBar.Value = 0

        [System.Windows.Forms.MessageBox]::Show(
            "Error:`n`n$($_.Exception.Message)",
            "Error",
            "OK",
            "Error"
        )
        return $false
    }
}

