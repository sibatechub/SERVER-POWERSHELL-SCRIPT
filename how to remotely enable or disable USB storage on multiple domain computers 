# ===== Load OUs =====
function LoadOUs {
    $OUCombo.Items.Clear()
    $OUCombo.Text = "Loading OUs..."
    try {
        $OUs = Get-ADOrganizationalUnit -Filter * | Select-Object -ExpandProperty Name | Sort-Object
        foreach ($OU in $OUs) {
            $OUCombo.Items.Add($OU)
        }
        if ($OUCombo.Items.Count -gt 0) {
            $OUCombo.SelectedIndex = 0
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Error loading OUs: $_")
    }
    $OUCombo.Text = ""
}
