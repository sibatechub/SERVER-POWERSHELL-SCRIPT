function Load-Users {
    $lblStatus.Text = "Loading users from Active Directory..."
    $lblStatus.ForeColor = [System.Drawing.Color]::DarkOrange
    $btnRefreshUsers.Enabled = $false
    $btnRefreshUsers.Text = "⏳ Loading..."
    $form.Refresh()
    
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        $global:allUsers = Get-ADUser -Filter * -Properties Name | Select-Object -ExpandProperty Name | Sort-Object
        $cmbUser.Items.Clear()
        foreach ($user in $global:allUsers) {
            $cmbUser.Items.Add($user)
        }
        if ($cmbUser.Items.Count -gt 0) {
            $cmbUser.SelectedIndex = 0
        }
        $lblStatus.Text = "Loaded $($cmbUser.Items.Count) users"
        $lblStatus.ForeColor = [System.Drawing.Color]::DarkGreen
    } catch {
        $lblStatus.Text = "Error loading users: $($_.Exception.Message)"
        $lblStatus.ForeColor = [System.Drawing.Color]::Red
        [System.Windows.Forms.MessageBox]::Show(
            "Error loading users from Active Directory:`n`n$($_.Exception.Message)",
            "Error",
            "OK",
            "Error"
        )
    } finally {
        $btnRefreshUsers.Enabled = $true
        $btnRefreshUsers.Text = "Refresh"
    }
}

function Load-Computers {
    $lblStatus.Text = "Loading computers from Active Directory..."
    $lblStatus.ForeColor = [System.Drawing.Color]::DarkOrange
    $btnRefreshComputers.Enabled = $false
    $btnRefreshComputers.Text = "⏳ Loading..."
    $form.Refresh()
    
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        $global:allComputers = Get-ADComputer -Filter * -Properties Name | Select-Object -ExpandProperty Name | Sort-Object
        $cmbComputer.Items.Clear()
        foreach ($computer in $global:allComputers) {
            $cmbComputer.Items.Add($computer)
        }
        if ($cmbComputer.Items.Count -gt 0) {
            $cmbComputer.SelectedIndex = 0
        }
        $lblStatus.Text = "Loaded $($cmbUser.Items.Count) users and $($cmbComputer.Items.Count) computers"
        $lblStatus.ForeColor = [System.Drawing.Color]::DarkGreen
    } catch {
        $lblStatus.Text = "Error loading computers: $($_.Exception.Message)"
        $lblStatus.ForeColor = [System.Drawing.Color]::Red
        [System.Windows.Forms.MessageBox]::Show(
            "Error loading computers from Active Directory:`n`n$($_.Exception.Message)",
