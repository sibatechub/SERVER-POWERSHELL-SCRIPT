function Install-App { 
    param($Computer, $Installer) 
    try { 
        if (-not (Test-Connection $Computer -Count 1 -Quiet)) { $global:log.AppendText("[$Computer] OFFLINE`r`n"); return }; 
        $global:log.AppendText("[$Computer] Connecting for Installation...`r`n"); $form.Refresh(); 
        $remote = "\\$Computer\C$\Temp"; if (!(Test-Path $remote)) { New-Item $remote -ItemType Directory -Force | Out-Null }; 
        $file = Split-Path $Installer -Leaf; Copy-Item $Installer "$remote\$file" -Force; $ext = [System.IO.Path]::GetExtension($Installer).ToLower(); 
        Invoke-Command -ComputerName $Computer -ScriptBlock { 
            param($file,$ext) $path = "C:\Temp\$file"; 
            if ($ext -eq ".msi") { 
                Start-Process "msiexec.exe" -ArgumentList "/i $path /qn /norestart" -Wait 
            } else { 
                if ($file -like "*anydesk*") {
                    Start-Process $path -ArgumentList '--install "C:\Program Files (x86)\AnyDesk" --with-silent-install' -Wait
                } elseif ($file -like "*chrome*") {
                    Start-Process $path -ArgumentList '/silent /install' -Wait
                } else {
                    Start-Process $path -ArgumentList "/S /quiet /silent /verysilent" -Wait 
                }
            } 
        } -ArgumentList $file,$ext; $global:log.AppendText("[$Computer] INSTALL SUCCESS`r`n") 
    } catch { $global:log.AppendText("[$Computer] INSTALL ERROR: $($_.Exception.Message)`r`n") } 
}

function Get-InstalledApps { 
    param($Computer) 
    $regPaths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*","HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*","HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*"); 
    Invoke-Command -ComputerName $Computer -ArgumentList (,$regPaths) -ScriptBlock { Get-ItemProperty $args[0] -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName } | Select-Object DisplayName } 
}

function Uninstall-App { 
    param($Computer, $AppName) 
    $global:log.AppendText("[$Computer] Scanning & Uninstalling: $AppName...`r`n"); $form.Refresh(); 
    try { 
        if (-not (Test-Connection $Computer -Count 1 -Quiet)) { return "OFFLINE" }; 
        $result = Invoke-Command -ComputerName $Computer -ArgumentList $AppName -ScriptBlock { 
            $name = $args[0]; 
            $regPaths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*","HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*","HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*"); 
            $app = Get-ItemProperty $regPaths -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like "*$name*" } | Select-Object -First 1; 
            if ($app) { 
                $unstring = $app.UninstallString; $displayName = $app.DisplayName; $registryPath = $app.PSPath; 
                if ($unstring -match "MsiExec") { 
                    $proc = Start-Process "msiexec.exe" -ArgumentList "/x $($app.PSChildName) /qn /norestart" -Wait -PassThru; 
                    if ($proc.ExitCode -eq 0 -or $proc.ExitCode -eq 3010) { return "SUCCESS (MSI Uninstalled)" } 
                }; 
                if ($unstring -match '^"([^"]+)"\s*(.*)$') { $exe = $Matches[1] } elseif ($unstring -match '^(.*?\.exe)\s*(.*)$') { $exe = $Matches[1].Trim() } else { $exe = $unstring.Split(' ')[0] }; 
                $exe = $exe.Replace('"', ''); 
                if (Test-Path $exe) { 
                    $silentSwitches = @("--uninstall --force-uninstall --system-level","/VERYSILENT /SUPPRESSMSGBOXES /NORESTART","/S","/silent /quiet /qn /norestart"); 
                    foreach ($switches in $silentSwitches) { 
                        $proc = Start-Process -FilePath $exe -ArgumentList $switches -PassThru -ErrorAction SilentlyContinue; 
                        $timeout = 10; $elapsed = 0; 
                        while (!$proc.HasExited -and $elapsed -lt $timeout) { Start-Sleep -Seconds 2; $elapsed += 2 }; 
                        if ($proc.HasExited) { 
                            $check = Get-ItemProperty $regPaths -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq $displayName }; 
                            if (!$check) { return "SUCCESS (Removed via arguments: $switches)" } 
                        } else { Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue } 
                    } 
                }; 
                if (Test-Path $exe) { 
                    $installDir = Split-Path (Split-Path $exe -Parent) -Parent; 
                    if ($installDir -match "Program Files|AppData|Google") { 
                        $exeName = [System.IO.Path]::GetFileNameWithoutExtension($exe); 
                        Stop-Process -Name $exeName -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2; 
                        Remove-Item -Path $installDir -Recurse -Force -ErrorAction SilentlyContinue 
                    } 
                }; 
                Remove-Item -Path $registryPath -Force -ErrorAction SilentlyContinue; return "SUCCESS (Forced Uninstall Completed)" 
            } else { return "NOT_FOUND_IN_REGISTRY" } 
        }; return $result 
    } catch { return "ERROR: $($_.Exception.Message)" } 
}

