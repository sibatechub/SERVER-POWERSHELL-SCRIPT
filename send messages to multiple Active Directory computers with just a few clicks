function Update-Counters {
    $selected = $listComputers.SelectedItems.Count
    $total = $listComputers.Items.Count
    $lblCount.Text = "Selected: $selected / Total: $total"
    $statusCount2.Text = "Selected: $selected"
}

function Load-OUs {
    try {
        $cmbOU.Items.Clear()
        $cmbOU.Items.Add("-- Select OU --")
        $ous = Get-ADOrganizationalUnit -Filter * -Properties Name, DistinguishedName | Sort-Object Name
        foreach ($ou in $ous) {
            $cmbOU.Items.Add("$($ou.Name)||$($ou.DistinguishedName)")
        }
        $cmbOU.SelectedIndex = 0
    }
    catch {
        $statusLabel.Text = "Failed to load OUs"
        $statusLabel.ForeColor = [System.Drawing.Color]::Orange
    }
}

function Load-ComputersFromAD {
    if ($script:IsLoading) { return }
    $script:IsLoading = $true
    $statusLabel.Text = "Loading all computers from AD..."
    $statusLabel.ForeColor = [System.Drawing.Color]::DarkBlue
    $listComputers.Items.Clear()
    try {
        $computers = Get-ADComputer -Filter * -Properties Name | Select-Object Name
        $script:AllComputers = $computers
        foreach ($pc in $computers | Sort-Object Name) {
            $listComputers.Items.Add("$($pc.Name)")
        }
        $statusLabel.Text = "Loaded $($listComputers.Items.Count) computers"
        $statusLabel.ForeColor = [System.Drawing.Color]::DarkGreen
        Update-Counters
    }
    catch {
        $statusLabel.Text = "Error: RSAT required"
        $statusLabel.ForeColor = [System.Drawing.Color]::Red
    }
    $script:IsLoading = $false
}

function Load-ComputersFromOU {
    if ($cmbOU.SelectedItem -eq $null -or $cmbOU.SelectedItem -eq "-- Select OU --") {
        [System.Windows.Forms.MessageBox]::Show("Please select an OU first", "Warning")
        return
    }
    $selectedOU = $cmbOU.SelectedItem
    $ouParts = $selectedOU -split '\|\|'
    $ouDN = $ouParts[1]
    
    $statusLabel.Text = "Loading OU..."
    $statusLabel.ForeColor = [System.Drawing.Color]::DarkBlue
    try {
        $computers = Get-ADComputer -Filter * -SearchBase $ouDN -Properties Name | Select-Object Name
        $listComputers.Items.Clear()
        $script:AllComputers = $computers
        foreach ($pc in $computers | Sort-Object Name) {
            $listComputers.Items.Add("$($pc.Name)")
        }
        $statusLabel.Text = "Loaded $($listComputers.Items.Count) from OU"
        $statusLabel.ForeColor = [System.Drawing.Color]::DarkGreen
        Update-Counters
    }
    catch {
        $statusLabel.Text = "Failed to load OU"
        $statusLabel.ForeColor = [System.Drawing.Color]::Red
    }
}

function Search-Computers {
    $searchText = $txtSearch.Text.Trim()
    if ($script:AllComputers.Count -eq 0) { return }

    $listComputers.Items.Clear()
    
    if ([string]::IsNullOrEmpty($searchText)) {
        foreach ($pc in $script:AllComputers | Sort-Object Name) {
            $listComputers.Items.Add("$($pc.Name)")
        }
    } else {
        $filtered = $script:AllComputers | Where-Object { $_.Name -match "^$([regex]::Escape($searchText))" }
        foreach ($pc in $filtered | Sort-Object Name) {
            $listComputers.Items.Add("$($pc.Name)")
        }
    }
    Update-Counters
}

function Ping-Computers {
    if ($listComputers.Items.Count -eq 0) { return }
    $progressBar.Visible = $true
    $statusLabel.Text = "Pinging..."
    $total = $listComputers.Items.Count
    for ($i = 0; $i -lt $total; $i++) {
        $progressBar.Value = [Math]::Min(100, [int]((($i + 1) / $total) * 100))
        $itemText = $listComputers.Items[$i]
        $pcName = ($itemText -replace '\s*\(Online\)', '' -replace '\s*\(Offline\)', '').Trim()
        
        $ping = Test-Connection -ComputerName $pcName -Count 1 -Quiet -ErrorAction SilentlyContinue
        if ($ping) {
            $listComputers.Items[$i] = "$pcName (Online)"
        } else {
            $listComputers.Items[$i] = "$pcName (Offline)"
        }
        [System.Windows.Forms.Application]::DoEvents()
    }
    $progressBar.Visible = $false
    $statusLabel.Text = "Ping done"
    Update-Counters
}

function Clear-Filters {
    $txtSearch.Text = ""
    if ($script:AllComputers.Count -gt 0) {
        $listComputers.Items.Clear()
        foreach ($pc in $script:AllComputers | Sort-Object Name) {
            $listComputers.Items.Add("$($pc.Name)")
        }
    }
    Update-Counters
}

function Remove-SelectedComputers {
    if ($listComputers.SelectedItems.Count -eq 0) { return }
    $selectedItems = @()
    foreach ($item in $listComputers.SelectedItems) { $selectedItems += $item }
    foreach ($item in $selectedItems) { $listComputers.Items.Remove($item) }
    
    $script:AllComputers = @()
    foreach ($item in $listComputers.Items) {
        $pcName = ($item -replace '\s*\(Online\)', '' -replace '\s*\(Offline\)', '').Trim()
        $script:AllComputers += [PSCustomObject]@{ Name = $pcName }
    }
    Update-Counters
}

function Remove-AllComputers {
    $listComputers.Items.Clear()
    $script:AllComputers = @()
    Update-Counters
}

function Send-Messages {
    $selected = $listComputers.SelectedItems
    if ($selected.Count -eq 0) { return }
    $message = $txtMessage.Text.Trim()
    if ([string]::IsNullOrEmpty($message)) { return }
    
    $progressBar.Visible = $true
    $btnSend.Enabled = $false
    $statusLabel.Text = "Sending messages asynchronously..."
    $statusLabel.ForeColor = [System.Drawing.Color]::DarkBlue
    
    $total = $selected.Count
    $success = 0
    $logEntries = @()
    $i = 0
    
    foreach ($selItem in $selected) {
        $i++
        $progressBar.Value = [Math]::Min(100, [int]((($i) / $total) * 100))
        $pcName = ($selItem -replace '\s*\(Online\)', '' -replace '\s*\(Offline\)', '').Trim()
        $logEntry = [PSCustomObject]@{ Computer = $pcName; Time = Get-Date -Format "HH:mm:ss"; Result = "Failed"; Reason = "" }
        
        $job = Start-Job -ScriptBlock {
            param($targetPC, $msgText)
            try {
                $session = New-CimSession -ComputerName $targetPC -OperationTimeoutSec 5 -ErrorAction Stop
                $result = Invoke-CimMethod -CimSession $session -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = "cmd.exe /c msg * /time:0 `"From: IT Administrator - $msgText`"" } -ErrorAction Stop
                Remove-CimSession -CimSession $session
                if ($result.ReturnValue -eq 0) { return $true }
            } catch {
                try {
                    $res = Invoke-Command -ComputerName $targetPC -ScriptBlock {
                        param($m)
                        $exp = Get-Process explorer -ErrorAction SilentlyContinue | Select-Object -First 1
                        if ($exp) {
                            $def = @'
                            using System;
                            using System.Runtime.InteropServices;
                            public class MsgBox {
                                [DllImport("user32.dll")]
                                public static extern IntPtr MessageBoxTimeout(IntPtr hWnd, String text, String caption, uint type, ushort languageId, uint milliseconds);
                                public static void Show(string message, string title) {
                                    MessageBoxTimeout(IntPtr.Zero, message, title, 0x00000040 | 0x00000000, 0, 0xFFFFFFFF);
                                }
                            }
'@
                            Add-Type -TypeDefinition $def -ErrorAction SilentlyContinue
                            [MsgBox]::Show("From: IT Administrator`n`n$m", "IT Administrator Message")
                            return $true
                        }
                        return $false
                    } -ArgumentList $msgText -ErrorAction Stop
                    if ($res) { return $true }
                } catch {}
            }
            return $false
        } -ArgumentList $pcName, $message
        
        $completed = Wait-Job $job -Timeout 4
        if ($completed) {
            $jobResult = Receive-Job -Job $job
            Remove-Job -Job $job -Force
            if ($jobResult) {
                $success++
                $logEntry.Result = "Success"
                $logEntry.Reason = "Message delivered"
            } else {
                $logEntry.Reason = "No active user session or unreachable"
            }
        } else {
            Stop-Job -Job $job -Force
            Remove-Job -Job $job -Force
            $logEntry.Reason = "Connection Timeout"
        }
        
        $logEntries += $logEntry
        [System.Windows.Forms.Application]::DoEvents()
    }
    
    $progressBar.Visible = $false
    $btnSend.Enabled = $true
    $statusLabel.Text = "Done - Success: $success of $total"
    $statusLabel.ForeColor = [Sys